{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimatelaw.org/protocol/extensions/ulp/v1/metadata.schema.json",
  "title": "ULP-A2A/1 Message Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "dictionary_digest",
    "record_ids"
  ],
  "properties": {
    "profile": {
      "const": "ULP-A2A/1"
    },
    "mode": {
      "enum": [
        "informational",
        "boundary-gating"
      ]
    },
    "dictionary_digest": {
      "const": "sha256:524222f5187df16880f2be58cc40e57fecb85fe781853efa190d50888d9a0abc"
    },
    "record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    }
  }
}

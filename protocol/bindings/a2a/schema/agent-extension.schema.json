{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimatelaw.org/protocol/extensions/ulp/v1/agent-extension.schema.json",
  "title": "ULP-A2A/1 AgentExtension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uri",
    "description",
    "required",
    "params"
  ],
  "properties": {
    "uri": {
      "const": "https://ultimatelaw.org/protocol/extensions/ulp/v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "ulp_protocol",
        "dictionary_digest",
        "record_schema",
        "record_media_type",
        "modes"
      ],
      "properties": {
        "profile": {
          "const": "ULP-A2A/1"
        },
        "ulp_protocol": {
          "const": "ultimate-law/1"
        },
        "dictionary_digest": {
          "const": "sha256:524222f5187df16880f2be58cc40e57fecb85fe781853efa190d50888d9a0abc"
        },
        "record_schema": {
          "const": "https://ultimatelaw.org/protocol/1/record.schema.json"
        },
        "record_media_type": {
          "const": "application/vnd.ultimatelaw.records+json;version=1"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "informational",
              "boundary-gating"
            ]
          }
        }
      }
    }
  }
}
